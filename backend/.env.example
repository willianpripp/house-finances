# Copy to backend/.env and fill in. .env is gitignored and holds live secrets.
#
# You do NOT need this file for `make demo`: the demo compose file passes every
# variable below straight to the container. This is for running the app
# directly against your own Postgres, or for a real (non-demo) install.

APP_NAME="House Finances"
# `production` makes the app refuse to boot without AUTH_SECRET. Use
# `development` while you are poking at it locally.
ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg://finances:finances@localhost:5432/finances

# Signs the session cookie. Required when ENVIRONMENT=production; without it
# every request just redirects to /login, which looks like being logged out
# forever. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=

# ---------------------------------------------------------------------------
# Bank sync — entirely optional. Leave all of it blank and the Connections page
# will tell you what is missing while every other page works normally.
# ---------------------------------------------------------------------------

# US institutions, from dashboard.plaid.com. `sandbox` is the safe value;
# `production` means live bank credentials.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Plaid transactions dated before this are dropped on ingest, so that months
# you have already closed by hand are never touched. YYYY-MM-DD.
PLAID_START_DATE=2026-06-01

# Encrypts stored Plaid access tokens at rest. Generate one:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Generate a NEW key only for a brand-new install. For an existing one this
# must be the key already in use: a different key makes every stored token
# permanently undecryptable, and the only recovery is re-linking every account,
# which mints new Items and resets the deduplication cursor. If decryption
# fails, the key is wrong — restore it, do not re-link.
FERNET_KEY=

# Brazilian institutions, from dashboard.pluggy.ai. Auth is app-level (client
# credentials exchanged for a short-lived API key), so items carry no
# per-connection secret and Fernet is not involved.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_START_DATE=2026-08-01

# Emergency hatch for the boot-time schema guard: 1 logs the drift and serves
# anyway instead of refusing to start. Never leave it on.
ALLOW_SCHEMA_DRIFT=0

# Optional: URL of a household portal page. When set, both UIs show a small
# house icon in the header linking to it. Empty = no icon.
PORTAL_URL=
